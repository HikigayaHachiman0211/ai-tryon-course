VITE_API_BASE_URL=http://localhost:8000
# URL of the virtual try-on workbench (full path to its HTML entry point).
# Dev default: http://127.0.0.1:8080/static/index.html
# Production deployments must set this explicitly.
VITE_TRYON_BASE_URL=http://127.0.0.1:8080/static/index.html
# URL of the administrator site. Development defaults to http://127.0.0.1:8081.
# Production deployments must set this explicitly.
VITE_ADMIN_BASE_URL=http://127.0.0.1:8081
