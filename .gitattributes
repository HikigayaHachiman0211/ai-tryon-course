# Normalize line endings: text files stored as LF in the repository
* text=auto

# Binary files: never normalize
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.bmp binary
*.svg text
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.zip binary
*.db binary
*.sqlite binary
*.sqlite3 binary
