.mode-switch {
  display: flex;
  padding: 6rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  margin-bottom: 18rpx;
}

.mode-tab {
  flex: 1;
  text-align: center;
  padding: 14rpx 12rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.68);
  font-weight: 500;
}

.mode-tab-active {
  background: linear-gradient(135deg, #0071e3, #2997ff);
  color: #ffffff;
  font-weight: 600;
}

.status-strip {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 20rpx;
  border-radius: 18rpx;
  margin-bottom: 18rpx;
  font-size: 23rpx;
}

.status-ok {
  background: rgba(48, 209, 88, 0.1);
  border: 1rpx solid rgba(48, 209, 88, 0.3);
}

.status-warn {
  background: rgba(245, 166, 35, 0.12);
  border: 1rpx solid rgba(245, 166, 35, 0.32);
}

.status-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
}

.dot-ok {
  background: #30d158;
}

.dot-warn {
  background: #f5a623;
}

.status-text {
  flex: 1;
  color: #ffffff;
}

.rate-text {
  color: rgba(255, 255, 255, 0.65);
}

.handoff-banner {
  margin-bottom: 18rpx;
  border-color: rgba(41, 151, 255, 0.28);
  background: rgba(0, 113, 227, 0.1);
}

.handoff-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 6rpx;
}

.handoff-meta {
  display: block;
  font-size: 22rpx;
  color: #93c5fd;
}

.dual-slots {
  display: flex;
  gap: 16rpx;
}

.slot-card {
  flex: 1;
  min-width: 0;
  padding: 20rpx;
}

.slot-title {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 14rpx;
}

.slot-preview-box {
  position: relative;
  width: 100%;
  height: 320rpx;
  border-radius: 18rpx;
  overflow: hidden;
  background: rgba(0, 0, 0, 0.45);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx;
  text-align: center;
}

.slot-img {
  width: 100%;
  height: 100%;
}

.slot-empty-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.48);
  line-height: 1.45;
}

.slot-loading-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.68);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 23rpx;
  color: #ffffff;
}

.slot-actions {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-top: 14rpx;
}

.slot-btn {
  width: 100%;
  min-height: 64rpx;
  font-size: 22rpx;
}

.control-row {
  margin-bottom: 20rpx;
}

.adv-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 18rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.05);
}

.adv-toggle-text {
  font-size: 24rpx;
  color: #64b5ff;
  font-weight: 500;
}

.adv-body {
  margin-top: 18rpx;
}

.adv-grid {
  display: flex;
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.submit-tryon-btn {
  margin-bottom: 22rpx;
}

.progress-track {
  height: 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.1);
  overflow: hidden;
  margin-bottom: 16rpx;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #0071e3, #64d2ff);
}

.logs-box {
  padding: 14rpx 16rpx;
  border-radius: 16rpx;
  background: rgba(0, 0, 0, 0.35);
}

.logs-heading {
  display: block;
  font-size: 21rpx;
  color: rgba(255, 255, 255, 0.55);
  margin-bottom: 8rpx;
}

.log-line {
  display: block;
  font-size: 21rpx;
  color: rgba(255, 255, 255, 0.78);
  line-height: 1.45;
}

.view-tabs {
  margin-top: 0;
  margin-bottom: 16rpx;
}

.result-stage-img {
  width: 100%;
  height: 620rpx;
  border-radius: 22rpx;
  background: rgba(0, 0, 0, 0.45);
  margin-bottom: 18rpx;
}

.result-actions {
  display: flex;
  gap: 14rpx;
  margin-bottom: 14rpx;
}

.animate-video-btn {
  margin-top: 4rpx;
}

.video-source-actions {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.video-source-thumb {
  width: 100%;
  height: 300rpx;
  margin-top: 16rpx;
  border-radius: 18rpx;
  background: rgba(0, 0, 0, 0.4);
}

.quote-hint {
  margin-bottom: 18rpx;
  text-align: center;
}

.video-btn-row {
  display: flex;
  gap: 14rpx;
  margin-bottom: 20rpx;
}

.video-result-card {
  margin-top: 6rpx;
}

.video-player {
  width: 100%;
  height: 460rpx;
  border-radius: 20rpx;
  margin-bottom: 16rpx;
  background: #000000;
}

.video-hist-item {
  margin-bottom: 12rpx;
}

.hist-model {
  font-size: 25rpx;
  font-weight: 600;
  color: #ffffff;
}

.modal-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1200;
  background: rgba(0, 0, 0, 0.74);
  display: flex;
  align-items: flex-end;
}

.modal-sheet {
  width: 100%;
  max-height: 82vh;
  background: #161619;
  border-top-left-radius: 32rpx;
  border-top-right-radius: 32rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.12);
  padding: 26rpx 24rpx calc(26rpx + env(safe-area-inset-bottom));
}

.close-link {
  font-size: 25rpx;
  color: #2997ff;
}

.modal-search-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.modal-search-btn {
  min-width: 120rpx;
  min-height: 76rpx;
}

.modal-scroll {
  max-height: 62vh;
}

.sample-modal-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.sample-modal-card {
  width: 31%;
  border-radius: 16rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.09);
  text-align: center;
}

.sample-modal-img {
  width: 100%;
  height: 210rpx;
  display: block;
}

.sample-modal-name {
  display: block;
  padding: 8rpx;
  font-size: 22rpx;
  color: #ffffff;
}

.catalog-pick-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
  margin-bottom: 12rpx;
}

.catalog-pick-img {
  width: 104rpx;
  height: 128rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.catalog-pick-title {
  display: block;
  font-size: 24rpx;
  color: #ffffff;
  margin-bottom: 6rpx;
}

.catalog-pick-price {
  font-size: 26rpx;
  font-weight: 700;
  color: #f5a623;
}

.center-loading {
  text-align: center;
  padding: 28rpx;
}
