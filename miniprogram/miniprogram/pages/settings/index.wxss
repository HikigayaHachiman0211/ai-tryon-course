.preset-wrap {
  margin-top: 0;
  margin-bottom: 22rpx;
}

.field-group {
  margin-bottom: 20rpx;
}

.btn-row {
  display: flex;
  gap: 14rpx;
}

.probe-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 16rpx 18rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.04);
  margin-bottom: 12rpx;
}

.probe-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
}

.probe-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.dot-idle {
  background: rgba(255, 255, 255, 0.25);
}

.dot-ok {
  background: #30d158;
  box-shadow: 0 0 10rpx rgba(48, 209, 88, 0.65);
}

.dot-warn {
  background: #f5a623;
  box-shadow: 0 0 10rpx rgba(245, 166, 35, 0.65);
}

.dot-fail {
  background: #ff453a;
  box-shadow: 0 0 10rpx rgba(255, 69, 58, 0.65);
}

.probe-label {
  font-size: 24rpx;
  color: #ffffff;
}

.probe-detail {
  font-size: 22rpx;
  flex-shrink: 0;
}

.detail-idle {
  color: rgba(255, 255, 255, 0.45);
}

.detail-ok {
  color: #7ee89a;
}

.detail-warn {
  color: #ffd080;
}

.detail-fail {
  color: #ff8a80;
}

.probe-btn {
  margin-top: 12rpx;
}

.tip-card {
  background: rgba(0, 113, 227, 0.08);
  border-color: rgba(41, 151, 255, 0.24);
}

.tip-body {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.82);
  line-height: 1.65;
  white-space: pre-line;
}
