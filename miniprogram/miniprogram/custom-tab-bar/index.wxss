.tabbar-root {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 950;
  padding: 12rpx 22rpx calc(14rpx + env(safe-area-inset-bottom));
  background: rgba(14, 14, 18, 0.94);
  border-top: 1rpx solid rgba(255, 255, 255, 0.09);
  backdrop-filter: blur(18px);
}

.tabbar-inner {
  display: flex;
  align-items: center;
  justify-content: space-around;
}

.tabbar-item {
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8rpx 6rpx;
  border-radius: 18rpx;
  color: rgba(255, 255, 255, 0.56);
}

.tabbar-item-active {
  color: #2997ff;
  background: rgba(41, 151, 255, 0.12);
}

.tabbar-glyph {
  font-size: 30rpx;
  line-height: 1.1;
  margin-bottom: 4rpx;
}

.tabbar-label {
  font-size: 21rpx;
  font-weight: 500;
}

.tabbar-dot {
  position: absolute;
  top: 6rpx;
  right: 26%;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #2997ff;
}
