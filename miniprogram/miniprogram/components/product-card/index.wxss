.product-card {
  padding: 24rpx;
}

.product-top {
  display: flex;
  gap: 20rpx;
}

.product-thumb {
  width: 196rpx;
  height: 248rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.05);
  flex-shrink: 0;
}

.product-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.badge-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.product-title {
  font-size: 27rpx;
  font-weight: 600;
  color: #ffffff;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.price-brand-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.product-price {
  font-size: 34rpx;
  font-weight: 700;
  color: #f5a623;
}

.product-brand {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
}

.fit-note {
  display: block;
  margin-top: 14rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.62);
}

.size-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

.size-pill {
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.8);
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.reason-box {
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  border-radius: 18rpx;
  background: rgba(0, 113, 227, 0.09);
  border: 1rpx solid rgba(41, 151, 255, 0.22);
}

.reason-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.88);
  line-height: 1.5;
}

.analysis-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding: 14rpx 18rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.05);
}

.analysis-toggle-text {
  font-size: 24rpx;
  color: #64b5ff;
  font-weight: 500;
}

.analysis-arrow {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.55);
}

.analysis-body {
  margin-top: 14rpx;
}

.action-row {
  display: flex;
  gap: 14rpx;
  margin-top: 20rpx;
}

.action-btn {
  flex: 1;
  min-height: 76rpx;
  font-size: 25rpx;
}
