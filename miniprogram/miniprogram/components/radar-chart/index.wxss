.radar-wrap {
  width: 100%;
  padding: 14rpx 8rpx 6rpx;
  border-radius: 20rpx;
  background: rgba(0, 0, 0, 0.28);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

.radar-header {
  padding: 0 16rpx 6rpx;
}

.radar-title {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.68);
  font-weight: 500;
}

.radar-canvas {
  width: 100%;
  height: 410rpx;
  display: block;
}
