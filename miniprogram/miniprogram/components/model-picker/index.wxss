.remove-link {
  font-size: 23rpx;
  color: #ff6961;
}

.preview-box {
  position: relative;
  width: 100%;
  height: 360rpx;
  border-radius: 22rpx;
  overflow: hidden;
  background: rgba(0, 0, 0, 0.45);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.preview-img {
  width: 100%;
  height: 100%;
}

.preview-badge {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.72);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  color: #ffffff;
  font-size: 22rpx;
}

.upload-dropzone {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 36rpx 24rpx;
  border-radius: 22rpx;
  border: 2rpx dashed rgba(255, 255, 255, 0.18);
  background: rgba(255, 255, 255, 0.03);
}

.upload-icon {
  width: 64rpx;
  height: 64rpx;
  line-height: 60rpx;
  border-radius: 50%;
  background: rgba(0, 113, 227, 0.2);
  color: #2997ff;
  font-size: 40rpx;
  margin-bottom: 12rpx;
}

.upload-main {
  font-size: 27rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 8rpx;
}

.upload-hint {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.54);
  line-height: 1.45;
}

.sample-section {
  margin-top: 22rpx;
}

.sample-head {
  margin-bottom: 12rpx;
}

.sample-gender-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.sample-scroll {
  width: 100%;
  white-space: nowrap;
}

.sample-list {
  display: inline-flex;
  gap: 14rpx;
  padding-bottom: 4rpx;
}

.sample-card {
  width: 138rpx;
  flex-shrink: 0;
  border-radius: 18rpx;
  overflow: hidden;
  border: 2rpx solid rgba(255, 255, 255, 0.08);
  background: rgba(255, 255, 255, 0.04);
  text-align: center;
}

.sample-card-active {
  border-color: #2997ff;
  box-shadow: 0 0 0 2rpx rgba(41, 151, 255, 0.32);
}

.sample-img {
  width: 138rpx;
  height: 184rpx;
  display: block;
}

.sample-name {
  display: block;
  padding: 8rpx 6rpx;
  font-size: 21rpx;
  color: rgba(255, 255, 255, 0.84);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
