.breakdown-box {
  margin-top: 14rpx;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.03);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

.breakdown-title {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.65);
  margin-bottom: 12rpx;
}

.breakdown-row {
  margin-bottom: 12rpx;
}

.breakdown-row:last-child {
  margin-bottom: 0;
}

.breakdown-head {
  display: flex;
  justify-content: space-between;
  font-size: 23rpx;
  margin-bottom: 6rpx;
}

.breakdown-name {
  color: rgba(255, 255, 255, 0.82);
}

.breakdown-score {
  color: #ffffff;
  font-weight: 600;
}

.breakdown-track {
  height: 10rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.08);
  overflow: hidden;
}

.breakdown-fill {
  height: 100%;
  border-radius: 999rpx;
}

.bar-blue {
  background: linear-gradient(90deg, #0071e3, #64d2ff);
}

.bar-gold {
  background: linear-gradient(90deg, #f5a623, #ffd479);
}
