page {
  background-color: #000000;
  color: #f5f5f7;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
  box-sizing: border-box;
  min-height: 100vh;
}

view,
text,
button,
input,
textarea,
scroll-view,
image,
picker {
  box-sizing: border-box;
}

button::after {
  border: none;
}

.page-shell {
  min-height: 100vh;
  padding: 20rpx 26rpx 40rpx;
  background: radial-gradient(circle at 50% -10%, rgba(0, 113, 227, 0.16), transparent 48%), #000000;
}

.safe-tab-spacer {
  height: calc(150rpx + env(safe-area-inset-bottom));
}

.safe-bottom-spacer {
  height: calc(48rpx + env(safe-area-inset-bottom));
}

.section-hero {
  padding: 18rpx 4rpx 24rpx;
}

.section-eyebrow {
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 2.5rpx;
  color: #2997ff;
  text-transform: uppercase;
  margin-bottom: 10rpx;
}

.hero-title {
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1.22;
  color: #ffffff;
  margin-bottom: 12rpx;
}

.hero-copy {
  font-size: 25rpx;
  color: rgba(255, 255, 255, 0.72);
  line-height: 1.55;
}

.card {
  background: rgba(29, 29, 32, 0.94);
  border: 1rpx solid rgba(255, 255, 255, 0.09);
  border-radius: 28rpx;
  padding: 26rpx;
  margin-bottom: 22rpx;
}

.card-subtle {
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 22rpx;
  padding: 20rpx;
}

.card-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
}

.field-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.field-label {
  font-size: 25rpx;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.86);
}

.required-badge {
  font-size: 20rpx;
  color: #2997ff;
  background: rgba(41, 151, 255, 0.14);
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
}

.ai-hint-badge {
  font-size: 20rpx;
  color: #64d2ff;
}

.dark-input,
.dark-picker,
.dark-textarea {
  width: 100%;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 18rpx;
  padding: 18rpx 22rpx;
  color: #ffffff;
  font-size: 26rpx;
}

.dark-input {
  min-height: 78rpx;
}

.dark-picker {
  min-height: 78rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.dark-textarea {
  min-height: 140rpx;
  line-height: 1.5;
}

.input-placeholder {
  color: rgba(255, 255, 255, 0.36);
}

.chip-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}

.chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.78);
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.chip-active {
  background: rgba(0, 113, 227, 0.24);
  border-color: #2997ff;
  color: #ffffff;
  font-weight: 600;
}

.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 86rpx;
  padding: 0 30rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #0071e3 0%, #2997ff 100%);
  color: #ffffff;
  font-size: 29rpx;
  font-weight: 600;
  box-shadow: 0 10rpx 28rpx rgba(0, 113, 227, 0.35);
}

.btn-primary[disabled] {
  opacity: 0.45;
  box-shadow: none;
}

.btn-secondary {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 76rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.09);
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  color: #f5f5f7;
  font-size: 26rpx;
  font-weight: 500;
}

.btn-secondary[disabled] {
  opacity: 0.45;
}

.btn-ghost {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 64rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: transparent;
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  color: rgba(255, 255, 255, 0.85);
  font-size: 24rpx;
}

.btn-danger {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 76rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  background: rgba(255, 69, 58, 0.18);
  border: 1rpx solid rgba(255, 69, 58, 0.45);
  color: #ff6961;
  font-size: 26rpx;
  font-weight: 600;
}

.muted-text {
  color: rgba(255, 255, 255, 0.56);
  font-size: 24rpx;
}

.error-banner {
  background: rgba(255, 69, 58, 0.14);
  border: 1rpx solid rgba(255, 69, 58, 0.4);
  color: #ff8a80;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
  font-size: 25rpx;
  line-height: 1.5;
}

.warn-banner {
  background: rgba(245, 166, 35, 0.14);
  border: 1rpx solid rgba(245, 166, 35, 0.4);
  color: #ffd080;
  border-radius: 20rpx;
  padding: 18rpx 22rpx;
  margin-bottom: 20rpx;
  font-size: 24rpx;
  line-height: 1.5;
}

.success-banner {
  background: rgba(48, 209, 88, 0.14);
  border: 1rpx solid rgba(48, 209, 88, 0.4);
  color: #7ee89a;
  border-radius: 20rpx;
  padding: 18rpx 22rpx;
  margin-bottom: 20rpx;
  font-size: 24rpx;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  background: rgba(255, 255, 255, 0.07);
  color: rgba(255, 255, 255, 0.78);
}

.tag-blue {
  background: rgba(0, 113, 227, 0.22);
  color: #64b5ff;
}

.tag-gold {
  background: rgba(245, 166, 35, 0.18);
  color: #ffc86b;
}

.flex-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.flex-1 {
  flex: 1;
  min-width: 0;
}
