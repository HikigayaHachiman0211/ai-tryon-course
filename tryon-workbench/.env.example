# 试衣站环境变量配置

# Google Cloud Project ID（使用 Vertex AI / GCS / Firestore 时填写）
GCP_PROJECT_ID=<your-gcp-project-id>

# Google Cloud Region (默认 us-central1)
GCP_LOCATION=us-central1

# 推荐系统联动（静态页面会通过 /api/frontend-config 读取这两个公开配置）
# 推荐系统页面地址，用于”返回推荐列表 / 换一件试试”入口
VITE_RECOMMEND_APP_URL=http://127.0.0.1:3000

# 试衣页嵌入模式：standalone | embed
VITE_TRYON_EMBED_MODE=standalone

# === 后台管理站数据库连接（试衣站运行时读取配置） ===
# 优先级: AI_CONFIG_DATABASE_URL > DATABASE_URL > 本地 admin_local.db
# AI_CONFIG_DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>
# DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>

# === Fernet 加密密钥（必须与后台管理站使用相同的密钥） ===
# FERNET_SECRET_KEY=<same-key-as-admin-service>

# === 灾备环境变量（仅在数据库不可用时使用） ===
# GEMINI_API_KEY=<your-gemini-api-key>
# TRYON_FLASH_MODEL=gemini-3.1-flash-image-preview
# TRYON_PRO_MODEL=gemini-3-pro-image-preview
