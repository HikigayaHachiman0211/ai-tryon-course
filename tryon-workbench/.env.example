# 试衣站环境变量配置

# Object storage provider: azure (production), gcs (legacy compatibility), or local (development)
OBJECT_STORAGE_PROVIDER=local
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_MEDIA_CONTAINER=course-media
AZURE_PRODUCT_CONTAINER=product-assets
PUBLIC_MEDIA_BASE_URL=http://127.0.0.1:8080/media

# Persistent directories. Azure Compose overrides these with named-volume paths.
UPLOAD_DIR=./uploads
ASSET_DIR=./assets
HISTORY_DIR=./history

# Google Cloud Project ID (使用 Vertex AI 时配置)
GCP_PROJECT_ID=

# Google Cloud Region (默认 us-central1)
GCP_LOCATION=us-central1

# 推荐系统联动（静态页面会通过 /api/frontend-config 读取这两个公开配置）
# 推荐系统页面地址，用于”返回推荐列表 / 换一件试试”入口
VITE_RECOMMEND_APP_URL=http://127.0.0.1:3000

# 试衣页嵌入模式：standalone | embed
VITE_TRYON_EMBED_MODE=standalone
CORS_ALLOW_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# === 后台管理站数据库连接（试衣站运行时读取配置） ===
# 优先级: AI_CONFIG_DATABASE_URL > DATABASE_URL > 本地 admin_local.db
# AI_CONFIG_DATABASE_URL=postgresql://user:pass@host:5432/dbname
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# === Fernet 加密密钥（必须与后台管理站使用相同的密钥） ===
# FERNET_SECRET_KEY=your-fernet-key-here

# === 灾备环境变量（仅在数据库不可用时使用） ===
# GEMINI_API_KEY=your_gemini_api_key_here
# TRYON_FLASH_MODEL=gemini-3.1-flash-image-preview
# TRYON_PRO_MODEL=gemini-3-pro-image-preview

# === 01Router 试穿视频（优先使用后台 AI 模型设置 → 试穿视频） ===
# 服务端设置，禁止使用 VITE_ 前缀或将密钥写入浏览器代码。
# 仅在后台数据库不可用或尚无视频配置记录时使用以下环境变量。
# ROUTER01_ENABLED=true
# ROUTER01_BASE_URL=https://01router.com/api/v1
# ROUTER01_API_KEY=your_project_api_key_here
# ROUTER01_PROJECT_ID=
# 外部视频供应商必须能访问图片；本地调试可填写公开图片 URL。
# 反向代理后的服务可显式配置公网工作台源站（无尾部斜杠）。
# ROUTER01_MEDIA_BASE_URL=https://your-public-tryon.example.com

# Decart Lucy VTON 3.6 实时试穿。金额单位为美元分，详见 DECART_REALTIME_SETUP.md。
DECART_REALTIME_ENABLED=false
DECART_API_KEY=
DECART_REALTIME_ACCESS_CODE=
# 线上填工作台 HTTPS origin（含非默认端口），可继承 WORKBENCH_PUBLIC_URL。
DECART_REALTIME_ORIGIN=
DECART_REALTIME_MAX_SECONDS=20
DECART_REALTIME_CENTS_PER_SECOND=2
DECART_REALTIME_DAILY_CENTS=200
DECART_REALTIME_MONTHLY_CENTS=1000
DECART_REALTIME_VISITOR_DAILY_CENTS=80
DECART_REALTIME_MAX_ACTIVE=1
DECART_REALTIME_STARTS_PER_MINUTE=3
