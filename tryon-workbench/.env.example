# Cosplay Generator 环境变量配置 (Vertex AI)

# Google Cloud Project ID (必填)
GCP_PROJECT_ID=<your-gcp-project-id>

# Google Cloud Region (默认 us-central1)
GCP_LOCATION=us-central1

# Vertex AI Express API Key (推荐 — 最简单的认证方式)
# 在 Vertex AI Studio > 设置 > API 密钥 中创建
VERTEX_AI_API_KEY=<your-vertex-ai-api-key>

# 推荐系统联动（静态页面会通过 /api/frontend-config 读取这两个公开配置）
# 推荐系统页面地址，用于“返回推荐列表 / 换一件试试”入口
VITE_RECOMMEND_APP_URL=<your-recommend-app-url>

# 试衣页嵌入模式：standalone | embed
VITE_TRYON_EMBED_MODE=standalone

# (已弃用) 旧 AI Studio API Key — 迁移后不再需要
# GEMINI_API_KEY=<your-gemini-api-key>
