# Example Azure Container Apps Scale-to-Zero Runtime Environment
# Copy to local gitignored .env.aca for reference or Key Vault seeding. Never commit real values.

APP_ENV=production
OBJECT_STORAGE_PROVIDER=azure
AZURE_STORAGE_ACCOUNT_NAME=tryonstEXAMPLE
AZURE_STORAGE_ACCOUNT=tryonstEXAMPLE
AZURE_PRODUCT_CONTAINER=product-images
AZURE_MEDIA_CONTAINER=course-media
AZURE_STORAGE_QUEUE_NAME=tryon-tasks
AZURE_CLIENT_ID=<USER_ASSIGNED_MANAGED_IDENTITY_CLIENT_ID>

DATABASE_URL=postgresql+psycopg://tryonadmin:<STRONG_PASSWORD>@tryon-pg-EXAMPLE.postgres.database.azure.com:5432/ai_tryon?sslmode=require
TASK_DATABASE_URL=postgresql+psycopg://tryonadmin:<STRONG_PASSWORD>@tryon-pg-EXAMPLE.postgres.database.azure.com:5432/ai_tryon?sslmode=require

FERNET_SECRET_KEY=<32_BYTE_URLSAFE_BASE64_FERNET_KEY>
JWT_SECRET_KEY=<RANDOM_HEX_OR_BASE64_SECRET>
INGEST_SECRET_KEY=<RANDOM_SHARED_INTERNAL_SECRET>
TASK_TOKEN_SECRET=<RANDOM_SHARED_TOKEN_SIGNING_SECRET>
USER_PHOTO_TOKEN_SECRET=<RANDOM_SHARED_TOKEN_SIGNING_SECRET>

TASK_EXECUTION_MODE=queue
TASK_QUEUE_PROVIDER=azure
WORKER_LEASE_SECONDS=180
WORKER_RENEW_INTERVAL_SECONDS=60
WORKER_VISIBILITY_TIMEOUT_SECONDS=240

ENABLE_DEBUG_PAGES=false
RUN_STARTUP_DB_INIT=false
ADMIN_REPORT_MODE=db
CORS_ALLOW_ORIGINS=https://tryon-main.EXAMPLE.azurecontainerapps.io,https://tryon-workbench.EXAMPLE.azurecontainerapps.io,https://tryon-admin.EXAMPLE.azurecontainerapps.io
