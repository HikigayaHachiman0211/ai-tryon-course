# Azure for Students course-demo environment template.
# Copy this file outside Git to /opt/ai-tryon-course/shared/azure.env and set
# every placeholder. Never put production credentials in this repository.

APP_ENV=production
COMPOSE_PROJECT_NAME=ai-tryon-course
APPLICATION_ENV_FILE=/opt/ai-tryon-course/shared/azure.env
IMAGE_NAMESPACE=ai-tryon-course
RELEASE_ID=replace-with-package-release-id

AZURE_FQDN=<dns-label>.<region>.cloudapp.azure.com
MAIN_PUBLIC_URL=https://<dns-label>.<region>.cloudapp.azure.com
ADMIN_PUBLIC_URL=https://<dns-label>.<region>.cloudapp.azure.com:8443
WORKBENCH_PUBLIC_URL=https://<dns-label>.<region>.cloudapp.azure.com:9443
WORKBENCH_ENTRY_URL=https://<dns-label>.<region>.cloudapp.azure.com:9443/static/index.html
CORS_ALLOW_ORIGINS=https://<dns-label>.<region>.cloudapp.azure.com,https://<dns-label>.<region>.cloudapp.azure.com:8443,https://<dns-label>.<region>.cloudapp.azure.com:9443
ACME_EMAIL=<private-budget-alert-or-acme-email>

POSTGRES_DB=ai_tryon
POSTGRES_USER=ai_tryon_app
POSTGRES_PASSWORD=<random-url-safe-hex>
DATABASE_URL=postgresql+psycopg://ai_tryon_app:<random-url-safe-hex>@postgres:5432/ai_tryon
AI_CONFIG_DATABASE_URL=postgresql+psycopg://ai_tryon_app:<random-url-safe-hex>@postgres:5432/ai_tryon

OBJECT_STORAGE_PROVIDER=azure
AZURE_STORAGE_ACCOUNT_NAME=<storage-account-name>
AZURE_STORAGE_CONNECTION_STRING=<secret-written-only-on-the-vm>
AZURE_PRODUCT_CONTAINER=product-assets
AZURE_MEDIA_CONTAINER=course-media
AZURE_BACKUP_CONTAINER=backups
PUBLIC_IMAGE_BASE_URL=https://<storage-account-name>.blob.core.windows.net/product-assets
PUBLIC_MEDIA_BASE_URL=https://<storage-account-name>.blob.core.windows.net/course-media
OBJECT_STORAGE_LOCAL_ROOT=/var/lib/ai-tryon/object-storage

JWT_SECRET_KEY=<at-least-32-random-bytes>
FERNET_SECRET_KEY=<valid-fernet-key-shared-by-all-services>
INGEST_SECRET_KEY=<random-secret>
ADMIN_INIT_USERNAME=<operator-selected-admin>
ADMIN_INIT_PASSWORD=<strong-initial-password>

GEMINI_API_KEY=<private-gemini-developer-key>
TRYON_FLASH_MODEL=<verified-flash-image-model-id>
TRYON_PRO_MODEL=<optional-verified-pro-model-id>
MIMO_API_KEY=<private-mimo-key>
DEEPSEEK_API_KEY=<optional-private-deepseek-key>
MIMO_MODEL=mimo-v2.6-flash
ASR_MODEL=mimo-v2.5-asr
TTS_MODEL=mimo-v2.5-tts

HISTORY_DIR=/var/lib/main/history
VOICE_CLONE_UPLOAD_DIR=/var/lib/admin/voice-clones
UPLOAD_DIR=/var/lib/workbench/uploads
ASSET_DIR=/var/lib/workbench/assets
WORKBENCH_HISTORY_DIR=/var/lib/workbench/history
VITE_TRYON_EMBED_MODE=standalone
VITE_RECOMMEND_APP_URL=https://<dns-label>.<region>.cloudapp.azure.com

# Optional Lucy VTON. Defaults and usage reporting are in the Workbench setup guide.
DECART_REALTIME_ENABLED=false
DECART_API_KEY=
DECART_REALTIME_ACCESS_CODE=
# DECART_REALTIME_ORIGIN defaults to WORKBENCH_PUBLIC_URL.
