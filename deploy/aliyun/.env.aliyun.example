# Alibaba Cloud ECS / lightweight server template. Copy outside the repository,
# fill every placeholder, and protect the resulting environment file.
APP_ENV=production
COMPOSE_PROJECT_NAME=ai-tryon-course
APPLICATION_ENV_FILE=/opt/ai-tryon-course/shared/aliyun.env
IMAGE_NAMESPACE=ai-tryon-course
RELEASE_ID=replace-with-release-id

PUBLIC_FQDN=<your-public-domain>
MAIN_PUBLIC_URL=https://<your-public-domain>
ADMIN_PUBLIC_URL=https://<your-public-domain>:8443
WORKBENCH_PUBLIC_URL=https://<your-public-domain>:9443
WORKBENCH_ENTRY_URL=https://<your-public-domain>:9443/static/index.html
CORS_ALLOW_ORIGINS=https://<your-public-domain>,https://<your-public-domain>:8443,https://<your-public-domain>:9443
ACME_EMAIL=<your-acme-email>

POSTGRES_DB=ai_tryon
POSTGRES_USER=ai_tryon_app
POSTGRES_PASSWORD=<random-url-safe-hex>
DATABASE_URL=postgresql+psycopg://ai_tryon_app:<random-url-safe-hex>@postgres:5432/ai_tryon
AI_CONFIG_DATABASE_URL=postgresql+psycopg://ai_tryon_app:<random-url-safe-hex>@postgres:5432/ai_tryon

OBJECT_STORAGE_PROVIDER=oss
OSS_REGION=cn-hangzhou
# Optional service endpoint; leave empty to use the SDK's regional default.
OSS_ENDPOINT=
OSS_PRODUCT_BUCKET=<globally-unique-product-bucket>
OSS_MEDIA_BUCKET=<globally-unique-media-bucket>
OSS_BACKUP_BUCKET=<optional-private-backup-bucket>
# Prefer an ECS RAM role. For environment credentials set mode=env and provide
# a scoped RAM AccessKey; an STS credential also requires OSS_SESSION_TOKEN.
OSS_CREDENTIAL_MODE=ecs_role
OSS_ECS_ROLE_NAME=<ecs-role-name>
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_SESSION_TOKEN=
PUBLIC_IMAGE_BASE_URL=https://<globally-unique-product-bucket>.oss-cn-hangzhou.aliyuncs.com
PUBLIC_MEDIA_BASE_URL=https://<globally-unique-media-bucket>.oss-cn-hangzhou.aliyuncs.com

JWT_SECRET_KEY=<at-least-32-random-bytes>
FERNET_SECRET_KEY=<valid-fernet-key-shared-by-all-services>
INGEST_SECRET_KEY=<random-secret>
ADMIN_INIT_USERNAME=<operator-selected-admin>
ADMIN_INIT_PASSWORD=<strong-initial-password>
GEMINI_API_KEY=<private-gemini-developer-key>
TRYON_FLASH_MODEL=<verified-flash-image-model-id>
TRYON_PRO_MODEL=<optional-verified-pro-model-id>
MIMO_API_KEY=<private-mimo-key>
DEEPSEEK_API_KEY=<optional-private-deepseek-key>
MIMO_MODEL=mimo-v2.6-flash
ASR_MODEL=mimo-v2.5-asr
TTS_MODEL=mimo-v2.5-tts

HISTORY_DIR=/var/lib/main/history
VOICE_CLONE_UPLOAD_DIR=/var/lib/admin/voice-clones
UPLOAD_DIR=/var/lib/workbench/uploads
ASSET_DIR=/var/lib/workbench/assets
WORKBENCH_HISTORY_DIR=/var/lib/workbench/history
VITE_TRYON_EMBED_MODE=standalone
VITE_RECOMMEND_APP_URL=https://<your-public-domain>

# Optional Lucy VTON. Defaults and usage reporting are in the Workbench setup guide.
DECART_REALTIME_ENABLED=false
DECART_API_KEY=
DECART_REALTIME_ACCESS_CODE=
# DECART_REALTIME_ORIGIN defaults to WORKBENCH_PUBLIC_URL.
